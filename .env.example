# Copy to `.env` and edit. Docker Compose loads it automatically; `.env` is gitignored
# because the webhook secret belongs in it.
#
#   cp .env.example .env
#
# Every setting is optional — with an empty .env the server runs with sensible defaults:
# it downloads the published catalog, re-checks it daily, and serves on 127.0.0.1:8000
# with the refresh webhook disabled.

# --- refresh webhook ---------------------------------------------------------------
# Enables `POST /catalog/refresh`, authenticated with GitHub's X-Hub-Signature-256 HMAC
# scheme. UNSET, THE ROUTE DOES NOT EXIST — refresh-on-demand is opt-in. Generate one:
#
#   openssl rand -hex 32
#
# Use the same value as the webhook's "Secret" in GitHub (repo → Settings → Webhooks),
# with Content type: application/json, pointed at https://<your-host>/catalog/refresh.
# LEGUMISTA_WEBHOOK_SECRET=

# --- catalog -----------------------------------------------------------------------
# Where the LIS catalog is downloaded from. Defaults to the published release asset.
# LEGUMISTA_CATALOG_URL=https://github.com/matthewwiese/datastore-metadata/releases/latest/download/catalog.json

# Pin a specific catalog instead of downloading one (also uncomment the matching mount in
# compose.yaml). Nothing is fetched, polling is off, and the webhook reports "pinned".
# LEGUMISTA_CATALOG_PATH=/etc/legumista/catalog.json

# Seconds between background freshness checks. The check is a conditional GET, so an
# unchanged catalog costs a 304 and no download. Default 86400 (24h); 0 disables polling.
# LEGUMISTA_CATALOG_POLL=86400

# --- exposure ----------------------------------------------------------------------
# Host interface and port to publish on. The default keeps the server on this machine.
# Set BIND to 0.0.0.0 only behind something that terminates TLS.
# LEGUMISTA_BIND=127.0.0.1
# LEGUMISTA_PORT=8000

# --- tools -------------------------------------------------------------------------
# Your address, sent to OpenAlex/Crossref for their polite pools (better rate limits,
# and they contact you before blocking rather than after).
# LEGUMISTA_CONTACT_EMAIL=you@example.org

# Raises the NCBI Entrez rate limit from 3 to 10 requests/second.
# NCBI_API_KEY=

# --- genomics tools ----------------------------------------------------------------
# The genomics tools may read from any public host; a built-in proxy refuses private
# addresses on every connection, redirects included. To narrow that to trusted hosts,
# list comma-separated scheme://host[/path] prefixes (matched by host, not by string).
# LEGUMISTA_PYSAM_ALLOWED_URLS=https://data.legumeinfo.org/,https://ftp.ncbi.nlm.nih.gov/

# Ports that proxy permits, how many bytes a connection may send (reads need ~1 KB; this
# bounds an upload), and when it drops a connection (idle / in total, seconds).
# LEGUMISTA_EGRESS_PORTS=80,443
# LEGUMISTA_EGRESS_MAX_SEND_BYTES=65536
# LEGUMISTA_EGRESS_IDLE_SECONDS=60
# LEGUMISTA_EGRESS_MAX_SECONDS=900

# Each samtools/bcftools call runs in a child process. Seconds before it is killed, how
# many may run at once, and the largest file one write may produce (bytes; 0 = no cap).
# LEGUMISTA_PYSAM_TIMEOUT=300
# LEGUMISTA_PYSAM_WORKERS=4
# LEGUMISTA_PYSAM_MAX_FILE_BYTES=4294967296

# Seconds a remote file's downloaded index is reused before it is fetched again.
# LEGUMISTA_INDEX_TTL=3600

# --- deployment and reports -------------------------------------------------------
# 'public' advertises every tool as read-only so a public host's users are not prompted
# before each call; the server's own checks stand in. Leave unset on your own machine,
# so your client asks before a tool writes a file or files an issue.
# LEGUMISTA_DEPLOYMENT=public

# The JBrowse instance browser_link prefers when several serve an assembly.
# LEGUMISTA_JBROWSE_INSTANCE=all-genera

# report_data_issue files data defects as GitHub issues, as a GitHub App (never as a
# person). It is served only when the server runs with --allow-report AND an App is
# configured (compose: add --allow-report to `command`, and uncomment the key mount).
# Create the App with one repository permission, Issues: read & write, and install it
# only on the repository below. Issues then come from the App's bot account.
# LEGUMISTA_GITHUB_APP_ID=
# LEGUMISTA_GITHUB_APP_KEY_FILE=/run/secrets/legumista-app.pem
# LEGUMISTA_GITHUB_APP_INSTALLATION_ID=
# LEGUMISTA_REPORT_REPOS=datastore=matthewwiese/datastore-metadata#datastore-issue,mine=matthewwiese/datastore-metadata#mine-issue
# LEGUMISTA_REPORT_DAILY_LIMIT=20
